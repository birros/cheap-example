{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/node",
    "sourceMap": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "moduleResolution": "nodenext",
    "declaration": true,
    "skipLibCheck": false,
    "downlevelIteration": true,
    "declarationMap": false,
    "module": "nodenext",
    "target": "ESNext",
    "esModuleInterop": true,
    "baseUrl": "./",
    "typeRoots": [
      "./node_modules/@types",
    ],
    "types": [
      "node"
    ],
    "lib": [
      "dom",
      "ESNext"
    ],
    "allowJs": false
  },
  "include": [
    "src/**/*.ts",
    "@types/index.d.ts"
  ],
  "exclude": [
    "*.test.ts",
    "__test__",
    "/node_modules/**",
    "src/**/consumer.ts",
    "src/**/consumerWorker.ts",
    "src/**/main.ts",
    "src/**/producer.ts",
    "src/**/producerWorker.ts"
  ]
}