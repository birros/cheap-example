{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "moduleResolution": "bundler",
    "declaration": true,
    "downlevelIteration": true,
    "declarationMap": false,
    "module": "esnext",
    "target": "ESNext",
    "esModuleInterop": true,
    "baseUrl": "./",
    "typeRoots": [
      "./node_modules/@types",
    ],
    "types": [
      "node"
    ],
    "lib": [
      "dom",
      "ESNext"
    ],
    "allowJs": false
  },
  "include": [
    "src/**/*.ts",
    "@types/index.d.ts"
  ],
  "exclude": [
    "*.test.ts",
    "__test__",
    "/node_modules/**"
  ]
}